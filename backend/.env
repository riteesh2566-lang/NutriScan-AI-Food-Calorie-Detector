# Database Connection Configuration (SQLite local default; set MySQL URL when running via Docker)
DATABASE_URL=sqlite:///./food_calorie.db

# JWT Token Signing Secret Key (Change to a strong random string in production)
JWT_SECRET=8f9a2b8e3c1d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f

# USDA FoodData Central API Key
# You can obtain a custom API key at: https://api.nal.usda.gov/
# Defaults to DEMO_KEY which has rate limits but is immediately functional.
USDA_API_KEY=DEMO_KEY
